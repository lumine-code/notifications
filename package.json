{
  "name": "notifications",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "A tidy way to display notifications.",
  "keywords": [
    "alert",
    "message",
    "toast",
    "warning",
    "error"
  ],
  "repository": "https://github.com/lumine-code/notifications",
  "bugs": {
    "url": "https://github.com/lumine-code/notifications/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "showErrorsInDevMode": {
      "title": "Show Errors In Dev Mode",
      "description": "Show notifications for uncaught exceptions even if Lumine is running in dev mode. If this config setting is disabled, uncaught exceptions will trigger the dev tools to open and be logged in the console tab.",
      "type": "boolean",
      "default": false
    },
    "defaultTimeout": {
      "title": "Default Timeout",
      "description": "The default notification timeout for a non-dismissable notification.",
      "type": "integer",
      "minimum": 1000,
      "default": 5000
    }
  },
  "deserializers": {
    "notifications/NotificationsLog": "createLog"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#83486ac8a670adb4381a9d4e2df3eb999f670ad1",
    "semver": "^7.8.5",
    "stacktrace-parser": "^0.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#f81b8d8cef089b525881432dd42efaf16b919bcb",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
